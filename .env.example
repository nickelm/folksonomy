# Copy to .env and fill in. Never commit .env.

# Password for the presenter views (/presenter). Pick something you can type
# quickly on a lectern keyboard but that a student cannot guess.
PRESENTER_PASSWORD=change-me

# Anthropic API key, used only for background tag merging.
# Leave blank or unset to run with merging disabled — everything else works.
ANTHROPIC_API_KEY=

# Port to listen on. Port 80 is unavailable on the droplet.
PORT=3000

# Public base URL, used to build the join URL and its QR code.
# Must match what students will actually type, including the port.
PUBLIC_BASE_URL=http://cooljaguar.duckdns.org:3000
